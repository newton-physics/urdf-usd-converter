<?xml version="1.0"?>
<robot name="visual_only_fixed">
  <link name="base">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <link name="drawn">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
  </link>
  <link name="zero">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
  </link>
  <link name="solid">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>
  <link name="bare"/>

  <joint name="drawn_joint" type="fixed">
    <origin xyz="0.1 0 0"/>
    <parent link="base"/>
    <child link="drawn"/>
  </joint>
  <joint name="zero_joint" type="fixed">
    <origin xyz="0 0.1 0"/>
    <parent link="base"/>
    <child link="zero"/>
  </joint>
  <joint name="solid_joint" type="fixed">
    <origin xyz="0 0 0.1"/>
    <parent link="base"/>
    <child link="solid"/>
  </joint>
  <joint name="bare_joint" type="fixed">
    <origin xyz="-0.1 0 0"/>
    <parent link="base"/>
    <child link="bare"/>
  </joint>
</robot>
