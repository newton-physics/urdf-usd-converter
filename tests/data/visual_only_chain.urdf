<?xml version="1.0"?>
<robot name="visual_only_chain">
  <link name="base">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <link name="drawn">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
  </link>
  <link name="link_box">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
  </link>

  <joint name="drawn_joint" type="fixed">
    <origin xyz="0 0 0.1"/>
    <parent link="base"/>
    <child link="drawn"/>
  </joint>
  <joint name="box_joint" type="revolute">
    <origin xyz="0 0 0.2"/>
    <parent link="drawn"/>
    <child link="link_box"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
