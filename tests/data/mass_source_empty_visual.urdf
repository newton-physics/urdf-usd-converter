<?xml version="1.0"?>
<robot name="mass_source_empty_visual">
  <link name="base">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <link name="empty"/>
  <link name="drawn">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="empty_joint" type="revolute">
    <parent link="base"/>
    <child link="empty"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="drawn_joint" type="fixed">
    <parent link="empty"/>
    <child link="drawn"/>
    <origin xyz="0.1 0 0"/>
  </joint>
</robot>
