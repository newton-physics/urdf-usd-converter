<?xml version="1.0"?>
<robot name="mesh_gltf">
  <link name="BaseLink">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </visual>
  </link>
  <link name="link_mesh_gltf">
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="assets/boxes.gltf" />
      </geometry>
    </visual>
  </link>
  <joint name="joint_mesh_gltf" type="fixed">
    <origin rpy="0 0 0" xyz="2 0 0"/>
    <parent link="BaseLink"/>
    <child link="link_mesh_gltf"/>
  </joint>
</robot>
