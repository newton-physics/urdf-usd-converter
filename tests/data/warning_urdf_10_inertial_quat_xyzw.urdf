<?xml version="1.0"?>
<!-- Warn if inertial origin uses quat_xyzw when the URDF version is earlier than 1.1. -->
<robot name="warning_urdf_10_inertial_quat_xyzw" version="1.0">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.1" quat_xyzw="0 0 0 1"/>
      <mass value="1"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
</robot>
